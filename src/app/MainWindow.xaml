<Window
    x:Class="yeet17.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="YEET17PCSET — Настройка Windows">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Ambient composition layer (arcs + glow) lives behind every control;
             visuals are attached from code via ElementCompositionPreview. -->
        <Grid x:Name="AmbientHost" Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False"/>

        <!-- Custom title bar: ExtendsContentIntoTitleBar so Mica/Acrylic paint through. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="22" Height="22" CornerRadius="7"
                        Background="{StaticResource AccentGradientBrush}">
                    <FontIcon Glyph="&#xE945;"
                              FontFamily="{StaticResource AppIconFontFamily}"
                              FontSize="11"
                              Foreground="#FFFFFF"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText"
                           Text="YEET17PCSET — Настройка Windows"
                           Style="{StaticResource TitleBarTextStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Grid x:Name="TitleBarCaptionPad" Grid.Column="1" Width="140"/>
        </Grid>

        <controls:NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneTitle="Настройка"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="224"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="NavView_SelectionChanged">

            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="Установка" Tag="install" Icon="Download"/>
                <controls:NavigationViewItem Content="Твики" Tag="tweaks">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;"/>
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Система" Tag="system" Icon="Setting"/>
                <controls:NavigationViewItem Content="Обновления" Tag="updates" Icon="Sync"/>
            </controls:NavigationView.MenuItems>

            <controls:Frame x:Name="ContentFrame" Padding="4,0,4,4"/>
        </controls:NavigationView>

        <Border Grid.Row="2" Style="{StaticResource FooterBarStyle}">
            <Grid Padding="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="ThemeLabel" Text="Тема" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}"/>
                    <ComboBox x:Name="ThemeCombo"
                              MinHeight="32" MinWidth="148"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Системная" Tag="system"/>
                        <ComboBoxItem Content="Тёмная" Tag="dark"/>
                        <ComboBoxItem Content="Светлая" Tag="light"/>
                    </ComboBox>
                    <TextBlock x:Name="VersionText" VerticalAlignment="Center"
                               Margin="8,0,0,0" Style="{StaticResource CaptionStyle}"/>
                    <Button x:Name="UpdateButton" Visibility="Collapsed"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="UpdateButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="TelegramButton" Click="TelegramButton_Click"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="0" Width="36" Height="34"
                            ToolTipService.ToolTip="Telegram — @yeet17">
                        <Viewbox Width="16" Height="16">
                            <PathIcon Foreground="#2AABEE"
                                      Data="M248,8C111.033,8,0,119.033,0,256S111.033,504,248,504,496,392.967,496,256,384.967,8,248,8ZM362.952,176.66c-3.732,39.215-19.881,134.378-28.1,178.3-3.476,18.584-10.322,24.816-16.948,25.425-14.4,1.326-25.338-9.517-39.287-18.661-21.827-14.308-34.158-23.215-55.346-37.177-24.485-16.135-8.612-25,5.342-39.5,3.652-3.793,67.107-61.51,68.335-66.746.153-.655.3-3.1-1.154-4.384s-3.59-.849-5.135-.5q-3.283.746-104.608,69.142-14.845,10.194-26.894,9.934c-8.855-.191-25.888-5.006-38.551-9.123-15.531-5.048-27.875-7.717-26.8-16.291q.84-6.7,18.45-13.7,108.446-47.248,144.628-62.3c68.872-28.647,83.183-33.623,92.511-33.789,2.052-.034,6.639.474,9.61,2.885a10.452,10.452,0,0,1,3.53,6.716A43.765,43.765,0,0,1,362.952,176.66Z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="GithubButton" Click="GithubButton_Click"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="0" Width="36" Height="34"
                            ToolTipService.ToolTip="GitHub — исходный код и релизы">
                        <Viewbox Width="16" Height="16">
                            <PathIcon Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="LoadButton" Content="Загрузить конфиг" Click="LoadButton_Click"
                            Style="{StaticResource GhostButtonStyle}"/>
                    <Button x:Name="SaveButton" Content="Сохранить конфиг" Click="SaveButton_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
