<Page
    x:Class="yeet17.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="10" Margin="20,14,20,10">
            <TextBlock x:Name="PageTitle" Text="Установка" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Программы через winget" Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0"/>
            <Grid Margin="0,4,0,0">
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Поиск программ…"
                         TextChanged="SearchBox_TextChanged"
                         MinHeight="34"
                         Padding="34,7,12,7"
                         CornerRadius="8"
                         FontFamily="{StaticResource AppFontFamily}"/>
                <FontIcon Glyph="&#xE721;"
                          FontFamily="{StaticResource AppIconFontFamily}"
                          FontSize="13"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <!-- Category chips wrap into rows (laid out in code); the old
                 horizontal scroller hid half the categories. -->
            <StackPanel x:Name="CategoryHost"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="InstallButton" Content="Установить выбранное" Style="{StaticResource AccentButtonStyle}" Click="Install_Click"/>
                <Button x:Name="UpgradeButton" Content="Обновить" Style="{StaticResource GhostButtonStyle}" Click="Upgrade_Click"/>
                <Button x:Name="UninstallButton" Content="Удалить" Style="{StaticResource GhostButtonStyle}" Click="Uninstall_Click"/>
                <Button x:Name="RefreshButton" Content="Получить установленные" Style="{StaticResource GhostButtonStyle}" Click="Refresh_Click"/>
            </StackPanel>
            <ProgressBar x:Name="Progress" IsIndeterminate="False" Visibility="Collapsed" Height="3"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="20,4">
            <StackPanel x:Name="CatalogHost" Spacing="4"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="20,10,20,14" Spacing="6">
            <TextBlock Text="ЖУРНАЛ" Style="{StaticResource SectionLabelStyle}"/>
            <TextBox x:Name="LogBox" Style="{StaticResource LogBoxStyle}"
                     MinHeight="104" MaxHeight="120"
                     Text="Журнал операций появится здесь."/>
        </StackPanel>
    </Grid>
</Page>
