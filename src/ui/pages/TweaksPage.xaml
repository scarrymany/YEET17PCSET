<Page
    x:Class="yeet17.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,14,20,10" Spacing="10">
            <TextBlock Text="Твики" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Приватность, телеметрия, интерфейс" Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,4,0,0">
                <Button Content="Минимальный" Tag="minimal" Style="{StaticResource ChipButtonStyle}" Click="Preset_Click"/>
                <Button Content="Стандартный" Tag="standard" Style="{StaticResource ChipButtonStyle}" Click="Preset_Click"/>
                <Button Content="Максимальный" Tag="maximal" Style="{StaticResource ChipButtonStyle}" Click="Preset_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Применить" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click"/>
                <Button Content="Отменить" Style="{StaticResource GhostButtonStyle}" Click="Undo_Click"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="20,4">
            <StackPanel>
                <TextBlock Text="ОСНОВНЫЕ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                <StackPanel x:Name="EssentialHost"/>
                <Border Style="{StaticResource WarningBannerStyle}" Margin="0,16,0,12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;"
                                  FontFamily="{StaticResource AppIconFontFamily}"
                                  FontSize="14"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  Foreground="{ThemeResource WarningTextBrush}"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   Foreground="{ThemeResource WarningTextBrush}"
                                   Text="Продвинутые твики меняют глубокие политики и службы. Создайте точку восстановления и читайте описание перед применением."/>
                    </Grid>
                </Border>
                <TextBlock Text="ПРОДВИНУТЫЕ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8"/>
                <StackPanel x:Name="AdvancedHost"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="20,10,20,14" Spacing="6">
            <TextBlock Text="ЖУРНАЛ" Style="{StaticResource SectionLabelStyle}"/>
            <TextBox x:Name="LogBox" Style="{StaticResource LogBoxStyle}"
                     MinHeight="104" MaxHeight="120"/>
        </StackPanel>
    </Grid>
</Page>
