<Page
    x:Class="yeet17.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Padding="20,14,20,14">
        <StackPanel Spacing="12">
            <TextBlock Text="Обновления" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,-6,0,0"
                       Text="Четыре режима официальной политики Windows Update. Служба wuauserv не отключается — это ломает обслуживание системы."/>

            <controls:RadioButtons x:Name="ModeGroup" Header="Режим" MaxColumns="4"
                                   SelectionChanged="ModeGroup_SelectionChanged">
                <x:String>Все обновления</x:String>
                <x:String>Только безопасность</x:String>
                <x:String>Приостановить</x:String>
                <x:String>По умолчанию</x:String>
            </controls:RadioButtons>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" Style="{StaticResource CardIconStyle}"/>
                        <TextBlock Text="Политика" Style="{StaticResource CardHeaderStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="ModeDescription" Style="{StaticResource BodyStyle}"
                               Text="Обычное поведение Windows Update: получать все обновления."/>
                    <Slider x:Name="PauseDays" Minimum="1" Maximum="35" Value="7"
                            MaxWidth="360" HorizontalAlignment="Left"
                            Header="Срок паузы (дни)" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Применить" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click"/>
                        <Button Content="Сбросить к умолчанию" Style="{StaticResource GhostButtonStyle}" Click="Reset_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="ЖУРНАЛ" Style="{StaticResource SectionLabelStyle}" Margin="0,4,0,-6"/>
            <TextBox x:Name="LogBox" Style="{StaticResource LogBoxStyle}" MaxHeight="140"/>
        </StackPanel>
    </ScrollViewer>
</Page>
